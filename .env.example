# AgentGuard Environment Configuration
# Project: AgentGuard: Temporal Graph-Based Detection and Prediction of Cascading Failures in Multi-Agent AI Systems

# General Settings
ENV=development
LOG_LEVEL=INFO
RANDOM_SEED=42

# API Server Settings
HOST=127.0.0.1
PORT=8000
DEBUG=True

# Database Settings
# For local research SQLite default is supported; PostgreSQL can be configured below
DATABASE_URL=sqlite:///./agentguard.db
# DATABASE_URL=postgresql+psycopg2://agentguard:agentguard@localhost:5432/agentguard

# ML & Experiment Settings
DATASET_DIR=./datasets
RESULTS_DIR=./results
ARTIFACTS_DIR=./artifacts

# Security
SECRET_KEY=agentguard-research-secret-key-change-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
